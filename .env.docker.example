# Optional overrides for docker compose. Copy to `.env` in the project root.
POSTGRES_PASSWORD=postgres
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Demo account demo / demo123 (set to false in production)
DEMO_USER_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
